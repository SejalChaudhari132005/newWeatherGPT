# Backend Environment Variables Example
# Copy to backend/.env or root .env

HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase Server Settings (Never expose service role key to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-Side Google Maps API Key for Geocoding & Search (Must remain backend-only)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# India Meteorological Department (IMD) API Configuration (Backend-Only)
IMD_API_KEY=your_imd_api_key_here
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
IMD_CACHE_TTL_SECONDS=900
IMD_TIMEOUT_SECONDS=10.0

# Allowed CORS Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# LLM Provider Configuration (Supported: groq, openai, gemini, mock, auto)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=600

# BHASHINI (National Language Translation Mission) Configuration (Backend-Only)
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_INFERENCE_KEY=your_bhashini_inference_key_here
BHASHINI_PIPELINE_ID=
BHASHINI_CACHE_TTL_SECONDS=3600
BHASHINI_TIMEOUT_SECONDS=15.0

