# Supabase Configuration (Frontend safe public anon key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:8000

# Backend Server Secrets (Backend only, never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Google Maps API Key (Backend only)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# India Meteorological Department (IMD) API Configuration (Backend-Only)
IMD_API_KEY=your_imd_api_key_here
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
IMD_CACHE_TTL_SECONDS=900
IMD_TIMEOUT_SECONDS=10.0

# LLM Provider Configuration (Backend only)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# BHASHINI (National Language Translation Mission) Configuration (Backend-Only)
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_INFERENCE_KEY=your_bhashini_inference_key_here
BHASHINI_PIPELINE_ID=
BHASHINI_CACHE_TTL_SECONDS=3600
BHASHINI_TIMEOUT_SECONDS=15.0

# Open-Meteo & Mapbox API Configuration
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Copernicus / Sentinel-2 Earth Observation Integration (Backend-Only)
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here